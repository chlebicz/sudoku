<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.komponentowe.view.AuthorsController">
   <children>
      <VBox fx:id="vbox" alignment="BOTTOM_CENTER" prefHeight="400.0" prefWidth="600.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="%sudoku">
               <VBox.margin>
                  <Insets bottom="40.0" />
               </VBox.margin></Text>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="%authors">
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin></Text>
         </children>
      </VBox>
   </children>
</AnchorPane>
